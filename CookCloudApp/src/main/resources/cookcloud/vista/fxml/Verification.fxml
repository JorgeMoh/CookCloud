<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="cookcloud.controlador.RegisterController"
    spacing="5">

    <padding>
        <Insets bottom="1.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <VBox>
        <Button text="&lt;" onAction="#volver" styleClass="volver"/>
    </VBox>


    <VBox spacing="15">

        <!--  RELLENO PARA CENTRAR LOS CAMPOS  -->
        <padding> <Insets top="35.0" bottom="45.0"/> </padding>

        <!--  CAMPO VERIFICAR  -->
        <VBox fx:id="vbCode" spacing="10">
            <Label text="Código de verificación:"/>
            <TextField promptText="Codigo..." fx:id="tfCode" alignment="CENTER"/>
        </VBox>

        <!--  BOTON  -->
        <HBox alignment="CENTER" spacing="7">
            <Button text="Verificar" onAction="#verificarYRegistrar"/>
        </HBox>

    </VBox>


</VBox>
