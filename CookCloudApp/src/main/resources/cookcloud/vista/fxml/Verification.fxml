<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="cookcloud.controlador.RegisterController"
      spacing="15" alignment="CENTER">

    <padding>
        <Insets bottom="1.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <VBox>
        <Button text="&lt;-" onAction="#volver"/>
    </VBox>

    <!--  CAMPO VERIFICAR  -->
    <VBox fx:id="vbCode">
        <Label text="Código de verificación:"/>
        <TextField promptText="Codigo..." fx:id="tfCode"/>
    </VBox>

    <!--  BOTON  -->
    <HBox alignment="CENTER" spacing="7">
        <Button text="Verificar" onAction="#verificarYRegistrar"/>
    </HBox>

</VBox>
