<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="cookcloud.controlador.SidebarController"
      spacing="5" alignment="TOP_CENTER" stylesheets="/cookcloud/vista/css/Sidebar.css"
      styleClass="principal">

    <!--  LOGO  -->
    <ImageView fitWidth="240" fitHeight="200">
        <image>
            <Image url="/cookcloud/data/CookCloud_Logo_Texto.png"/>
        </image>
    </ImageView>

    <Separator/>

    <!--  BOTONES DE NAVEGACIÓN  -->
    <Button text="Mis recetas" onAction="#mostrarMisRecetas" styleClass="btSelect" fx:id="btMisrecetas"/>

    <Button text="Explorar" onAction="#mostrarExplorador" fx:id="btBuscar"/>

    <Button text="Ajustes" onAction="#mostrarAjustes" fx:id="btAjustes"/>

    <Separator/>

    <!--  BOTÓN DE CERRAR SESIÓN  -->
    <Button text="Cerrar Sesión" onAction="#cerrarSesion"/>


</VBox>
