<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="cookcloud.controlador.LoginController"
      spacing="15" alignment="CENTER">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="2.0"/>
    </padding>

    <ImageView fitWidth="200" fitHeight="140" smooth="false">
        <Image url="/cookcloud/data/CookCloud_Logo_Texto.png"/>
    </ImageView>

    <!--  CAMPO USUARIO  -->
    <VBox fx:id="vbUser">
        <Label text="Usuario:"/>
        <TextField fx:id="tfUser" promptText="Usuario/Correo..."/>
    </VBox>

    <!--  CAMPO CONTRASEÑA  -->
    <VBox fx:id="vbPass">
        <Label text="Contraseña:"/>
        <PasswordField fx:id="tfPass" promptText="Contraseña..."/>
    </VBox>

    <VBox fx:id="vbErrorGen" alignment="CENTER"/>

    <!--  BOTON INICIAR SESION  -->
    <Button text="Iniciar Sesion" onAction="#iniciarSesion"/>

    <!--  ACCESO AL REGISTRO  -->
    <Label  styleClass="enlace" text="Registrarse ->" onMouseClicked="#irARegistro"/>

    <!--  ACCESO RECUPERACION DE CUENTA  -->
    <Label  styleClass="enlace" text="¿Has olvidado tu contraseña?" onMouseClicked="#irARecuperacion"/>

</VBox>
