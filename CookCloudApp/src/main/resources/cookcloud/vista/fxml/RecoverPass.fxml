<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="cookcloud.controlador.RecoverPassController"
      spacing="10" alignment="CENTER" VBox.vgrow="ALWAYS">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <!--  BOTÓN DE VOLVER  -->
    <HBox>
        <Button onAction="#irALogin" styleClass="volver">
            <graphic>
                <FontAwesomeIconView glyphName="ARROW_LEFT" size="16"/>
            </graphic>
        </Button>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" spacing="15" alignment="CENTER">

        <!--  SECCION CORREO  -->
        <VBox fx:id="vbEmail">
            <Label text="Correo de verificación:"/>
            <TextField promptText="Correo..." fx:id="tfCorreo" HBox.hgrow="ALWAYS"/>
        </VBox>

        <Button onAction="#correoDeRecuperacion" text="Enviar"/>

    </VBox>

</VBox>
